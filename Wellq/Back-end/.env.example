# Copiar a .env (no versionado) y completar. Sin valores reales aquí.
PORT=5000
MONGODB_URI=
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Contraseña común de los usuarios demo sintéticos (si se omite, usa la de src/auth/demoUsers.ts)
DEMO_PASSWORD=
# Orígenes permitidos por CORS, separados por coma (ej. la URL del frontend en Vercel).
# Vacío = abierto (solo desarrollo local).
CORS_ORIGINS=
# 1 = si la colección de exámenes está vacía, sembrar los exámenes SINTÉTICOS de demo (solo despliegue de demo).
SEED_DEMO_DATA=
# Timeout de conexión a MongoDB en ms (por defecto 1500; en Vercel/Atlas usar ~8000).
MONGODB_TIMEOUT_MS=
