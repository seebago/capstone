{
  "name": "wellmedical",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "front-end",
    "back-end"
  ],
  "scripts": {
    "dev": "concurrently -n \"FRONT,BACK\" -c \"cyan,green\" \"npm run dev --workspace=front-end\" \"npm run dev --workspace=back-end\"",
    "dev:front": "npm run dev --workspace=front-end",
    "dev:back": "npm run dev --workspace=back-end",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
